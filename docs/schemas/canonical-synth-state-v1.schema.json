{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jeremybboy/agentic-synth-twin/blob/main/docs/schemas/canonical-synth-state-v1.schema.json",
  "title": "Agentic Synth Twin canonical synth state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plugin", "parameters", "opaque_state", "evidence"],
  "properties": {
    "schema": {
      "const": "agentic-synth-twin/canonical-synth-state/v1"
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clap_id",
        "name",
        "vendor",
        "version",
        "source_repository",
        "source_commit"
      ],
      "properties": {
        "clap_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "vendor": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_repository": {"type": "string", "format": "uri"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "module",
          "unit",
          "min",
          "max",
          "default",
          "current",
          "flags",
          "automatable",
          "modulatable"
        ],
        "properties": {
          "id": {"type": "integer", "minimum": 0},
          "name": {"type": "string", "minLength": 1},
          "module": {"type": ["string", "null"], "minLength": 1},
          "unit": {"type": ["string", "null"], "minLength": 1},
          "min": {"type": "number"},
          "max": {"type": "number"},
          "default": {"type": "number"},
          "current": {"type": "number"},
          "flags": {"type": "integer", "minimum": 0},
          "automatable": {"type": "boolean"},
          "modulatable": {"type": "boolean"}
        }
      }
    },
    "opaque_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "byte_length", "sha256", "data"],
      "properties": {
        "encoding": {"const": "base64"},
        "byte_length": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "data": {"type": "string", "contentEncoding": "base64", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_method",
        "parameter_count",
        "selected_parameter_restore_verified"
      ],
      "properties": {
        "capture_method": {"const": "clap.params+clap.state"},
        "parameter_count": {"type": "integer", "minimum": 1},
        "selected_parameter_restore_verified": {"const": true}
      }
    }
  }
}
